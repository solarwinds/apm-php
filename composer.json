{
  "name": "solarwinds/apm",
  "description": "Solarwinds specific OpenTelemetry SDK for PHP",
  "keywords": ["solarwinds_apm", "swo", "instrumentation", "performance", "opentelemetry", "observability"],
  "type": "library",
  "homepage": "https://github.com/solarwinds/apm-php",
  "readme": "./README.md",
  "license": "Apache-2.0",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": "^8.1",
    "google/protobuf": "^3.22 || ^4.0 || ^5.0",
    "nyholm/psr7-server": "^1.1",
    "open-telemetry/api": "^1.10",
    "open-telemetry/exporter-otlp": "^1.4",
    "open-telemetry/sdk": "^1.15.0",
    "open-telemetry/sdk-configuration": "^0.9",
    "open-telemetry/sem-conv": "^1.44",
    "php-http/discovery": "^1.14",
    "psr/http-client": "^1.0",
    "psr/http-client-implementation": "^1.0",
    "psr/http-factory-implementation": "^1.0",
    "psr/http-message": "^1.0.1|^2.0",
    "psr/log": "^1.1|^2.0|^3.0",
    "ramsey/uuid": "^3.0 || ^4.0"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "bamarni/composer-bin-plugin": true,
      "composer/package-versions-deprecated": true,
      "php-http/discovery": true,
      "symfony/runtime": true,
      "tbachert/spi": true
    }
  },
  "authors": [
    {
      "name": "Jerry Leung",
      "email": "tingfung.leung@solarwinds.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "Solarwinds\\ApmPhp\\": "src/"
    },
    "files": [
      "src/_autoload.php",
      "src/Propagator/TraceState/_register.php",
      "src/Propagator/XTraceOptions/_register.php",
      "src/Resource/_register.php",
      "src/ResponsePropagator/XTrace/_register.php",
      "src/ResponsePropagator/XTraceOptionsResponse/_register.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Solarwinds\\ApmPhp\\Tests\\Unit\\": "tests/Unit/",
      "Solarwinds\\ApmPhp\\Tests\\Benchmark\\": "tests/Benchmark/",
      "Solarwinds\\ApmPhp\\Tests\\Integration\\": "tests/Integration/"
    }
  },
  "require-dev": {
    "bamarni/composer-bin-plugin": "^1.8",
    "mockery/mockery": "^1.6.15",
    "open-telemetry/dev-tools": "^0.2",
    "phpspec/prophecy": "^1.22",
    "phpspec/prophecy-phpunit": "^2",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-mockery": "^2.0",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpunit/phpunit": "^10 || ^11"
  },
  "extra": {
    "bamarni-bin": {
      "bin-links": false,
      "target-directory": "vendor-bin",
      "forward-command": true
    },
    "spi": {
      "OpenTelemetry\\API\\Configuration\\Config\\ComponentProvider": [
        "Solarwinds\\ApmPhp\\ComponentProvider\\Detector\\DetectorK8s",
        "Solarwinds\\ApmPhp\\ComponentProvider\\Detector\\DetectorApm",
        "Solarwinds\\ApmPhp\\ComponentProvider\\Detector\\DetectorUams",
        "Solarwinds\\ApmPhp\\ComponentProvider\\Propagator\\PropagatorTraceState",
        "Solarwinds\\ApmPhp\\ComponentProvider\\Propagator\\PropagatorXTraceOptions",
        "Solarwinds\\ApmPhp\\ComponentProvider\\ResponsePropagator\\ResponsePropagatorXTrace",
        "Solarwinds\\ApmPhp\\ComponentProvider\\ResponsePropagator\\ResponsePropagatorXTraceOptionsResponse",
        "Solarwinds\\ApmPhp\\ComponentProvider\\Trace\\SamplerSwoHttp",
        "Solarwinds\\ApmPhp\\ComponentProvider\\Trace\\SamplerSwoJson",
        "Solarwinds\\ApmPhp\\ComponentProvider\\Trace\\SpanProcessorResponseTime"
      ]
    },
    "scripts": {
      "test-psr3": [
        "OpenTelemetry\\Tests\\Integration\\Composer\\Psr3Compatability::run"
      ]
    }
  }
}
